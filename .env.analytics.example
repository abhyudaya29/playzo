# OPTIONAL additions to your deployment environment; do not commit real values.
# Next.js public configuration is embedded at build time. Use the exact project
# ingest host shown in PostHog Cloud (not a guessed region or personal API key).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Server delivery uses the same public project key and exact ingest host.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
# Private dashboard URL; staff still need separate PostHog project permissions.
POSTHOG_DASHBOARD_URL=
