# Copy to .env.release on the release host; never commit actual credentials.
POSTGRES_PASSWORD=replace-with-a-strong-password
# Match POSTGRES_PASSWORD above; URL-encode special characters in this URL.
DATABASE_URL=postgresql+asyncpg://playzo:replace-with-a-strong-password@db:5432/playzo
CLERK_ISSUER=https://your-clerk-frontend-api-host
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=https://api.playzo.example
FRONTEND_ORIGINS=https://playzo.example
# Host reverse proxy upstreams; bound to loopback only.
FRONTEND_PORT=3001
API_PORT=8001
